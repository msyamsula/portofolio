# HTTP server
PORT=8080
SERVICE_PORT=8080

# Postgres
POSTGRES_PORT=5432
POSTGRES_DB=auto_pr_review
POSTGRES_USER=auto_pr_review
POSTGRES_PASSWORD=auto_pr_review
POSTGRES_MAX_CONNECTIONS=32
POSTGRES_IDLE_IN_TRANSACTION_SESSION_TIMEOUT=30000

# HTTP timeouts
HTTP_REQUEST_TIMEOUT=5s
HTTP_READ_HEADER_TIMEOUT=2s
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s

# Postgres pool
POSTGRES_POOL_MAX_CONNS=8
POSTGRES_POOL_MIN_CONNS=1
POSTGRES_POOL_MAX_CONN_LIFETIME=30m
POSTGRES_POOL_MAX_CONN_IDLE_TIME=5m
POSTGRES_EXEC_TIMEOUT=3s

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=8
REDIS_MIN_IDLE_CONNS=1
REDIS_EXEC_TIMEOUT=3s
REDIS_MAX_CLIENTS=64
REDIS_IDLE_TIMEOUT_SECONDS=60

# Job scheduler
JOB_ORCHESTRATOR_INTERVAL=1s
JOB_PERIOD_OPTIONS=1s,10m,5h

# Kafka broker
KAFKA_PORT=9092
KAFKA_KRAFT_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw

# Kafka producer
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=pr_review
KAFKA_DLQ_TOPIC=pr_review_dlq
KAFKA_CLIENT_ID=auto-pr-review-job-orchestrator
KAFKA_MAX_RETRIES=5
KAFKA_RETRY_BACKOFF=100ms
KAFKA_MAX_IN_FLIGHT=10
KAFKA_PUBLISH_TIMEOUT=3s

# Kafka consumer
KAFKA_CONSUMER_GROUP_ID=auto_pr_review
KAFKA_CONSUMER_MAX_RETRIES=5
KAFKA_CONSUMER_RETRY_BACKOFF=5s
KAFKA_CONSUMER_ATTEMPT_TIMEOUT=30m
KAFKA_CONSUMER_MAX_IN_FLIGHT=15
KAFKA_CONSUMER_LOCK_TTL=5m

# Kafka debug / monitoring
KAFKA_DEBUG_GROUP=auto_pr_debugging
KAFKA_RUNNING_GROUP=auto_pr_review

# LLM interface
LLM_PROVIDER=deepseek
LLM_REQUEST_TIMEOUT=1m
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF=500ms
LLM_MAX_IDLE_CONNS=10
LLM_MAX_IDLE_CONNS_PER_HOST=10
LLM_MAX_CONNS_PER_HOST=10

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ChatGPT
OPENAI_API_KEY=
OPENAI_MODEL=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# GitHub / PR review
GITHUB_TOKEN_PATH=

PR_REVIEW_OUTPUT_DIR=reports

# PR review agent
PR_REVIEW_AGENT_WORKSPACE_ROOT=
PR_REVIEW_AGENT_DEVELOP_BRANCH=develop
PR_REVIEW_AGENT_OUTPUT_DIR=reports/agent
PR_REVIEW_AGENT_TRACE_DIR=reports/agent/traces
PR_REVIEW_AGENT_GIT_USER=Muhammad Syamsul Arifin
PR_REVIEW_AGENT_GIT_EMAIL=muhammad.syamsul@astronauts.id
