# PostgreSQL administrator and initial database
POSTGRES_ADMIN_USER=billing_admin
POSTGRES_ADMIN_PASSWORD=change_me
POSTGRES_DB=amartha
POSTGRES_PORT=5432

# PgBouncer application endpoint
PGBOUNCER_PORT=6432
PGBOUNCER_MAX_CLIENT_CONNECTIONS=1000
PGBOUNCER_DEFAULT_POOL_SIZE=100
PGBOUNCER_SERVER_LIFETIME_SECONDS=900
PGBOUNCER_SERVER_IDLE_TIMEOUT_SECONDS=300

# PgBouncer opens at most 100 upstream connections for this single user/database
# pair. PostgreSQL keeps 10 additional slots for maintenance and administration.
POSTGRES_MAX_CONNECTIONS=110

